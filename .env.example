# Copy to .env and fill in. With no PayPal keys, PayQuill runs against a local
# mock (labelled "PayPal mock" in the app).

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app's Webhooks section (needs a public URL).
# Leave empty locally: PayQuill checks payment status with PayPal every 10 seconds.
PAYPAL_WEBHOOK_ID=

# Sandbox personal account that receives and pays the invoices (judges log in with it)
SANDBOX_BUYER_EMAIL=
# Sandbox personal account that receives supplier payouts (can be the same account)
SANDBOX_PAYEE_EMAIL=

# --- Claude (recommended: writes invoices and reminders, reads bill PDFs and photos) ---
# Without a key, PayQuill runs with an offline fallback (labelled "AI offline").
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- App ---
PORT=5000
PUBLIC_URL=http://localhost:5000
OPENING_BALANCE=18000
CASH_BUFFER=5000
CASH_YIELD_RATE=0.045
SCHEDULER_INTERVAL_SECONDS=3600
